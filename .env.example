# Load the fictional demo athlete on first run in production builds (always on in dev).
VITE_DEMO_AUTOLOAD=false

# Accounts and sync (optional). Without these the app runs on this device only.
# Use the public anon / publishable key. Never put the service role or secret key here:
# anything prefixed VITE_ is shipped to every browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
